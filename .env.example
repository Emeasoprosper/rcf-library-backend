# --- Database (Supabase or Neon — both have free Postgres tiers) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAILS=emeasoprosper@gmail.com

# --- Google OAuth (for verifying Google Identity Services tokens from the frontend) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Google Drive (file storage) ---
# Service account with Drive API enabled — each of the folders below must
# be individually shared with this service account's email (Editor access),
# since service accounts don't have their own visible "My Drive."
GOOGLE_SERVICE_ACCOUNT_EMAIL=kdrop-drive-uploader@k-drop-501415.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Folder routing — each upload category lands in its own Drive folder
# (see src/config/driveFolders.js for the routing logic). IDs below are
# pre-filled from the folders you already created.
GOOGLE_DRIVE_FOLDER_AUDIO=1IRlgEbUHNYskfjrXHVbCkt-BE6jiwC5P
GOOGLE_DRIVE_FOLDER_IMG=162-CEql0cME-kHlSuo7eenRpHxCrYsRb
